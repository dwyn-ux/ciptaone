---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/site';
import { playstore } from '../../data/playstore';
---

<Layout
  title="Status Pembayaran — Cipta One"
  description="Cek status pembayaran layanan rilis Play Store Cipta One."
  canonical={`${site.url}/rilis-aplikasi/status`}
>
  <section id="top" class="status-section">
    <div class="shell status-shell">
      <div class="mono status-eyebrow">
        <span class="chapter-num">C1</span>
        <span class="chapter-rule" aria-hidden="true"></span>
        <span data-en="ORDER STATUS / DUITKU" data-id="STATUS PESANAN / DUITKU">ORDER STATUS / DUITKU</span>
      </div>

      <div class="status-card" data-reveal>
        <div class="card-head mono">
          <span data-en="PAYMENT CONFIRMATION" data-id="KONFIRMASI PEMBAYARAN">PAYMENT CONFIRMATION</span>
          <span class="card-id">C1 / PLAY</span>
        </div>

        <div id="status-body" class="status-body" aria-live="polite">
          <div class="status-loading">
            <span class="spinner" aria-hidden="true"></span>
            <p data-en={playstore.statusChecking.en} data-id={playstore.statusChecking.id}>{playstore.statusChecking.en}</p>
          </div>
        </div>

        <div class="card-foot">
          <div class="foot-row">
            <span class="mono" data-en="ORDER ID" data-id="ID PESANAN">ORDER ID</span>
            <strong id="order-id" class="mono">—</strong>
          </div>
          <div class="foot-row">
            <span class="mono" data-en="REFERENCE" data-id="REFERENSI">REFERENCE</span>
            <strong id="reference" class="mono">—</strong>
          </div>
        </div>
      </div>

      <div class="status-actions">
        <button type="button" class="btn btn-ghost" id="refresh-btn">
          <span data-en="CHECK AGAIN" data-id="CEK ULANG">CHECK AGAIN</span>
          <span aria-hidden="true">↻</span>
        </button>
        <a class="btn btn-solid" href="/rilis-aplikasi">
          <span data-en="BACK TO SERVICE" data-id="KEMBALI KE LAYANAN">BACK TO SERVICE</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <p class="help-line" data-en="Payment confirmation is sent by email and WhatsApp within minutes after Duitku receives your payment." data-id="Konfirmasi pembayaran dikirim via email dan WhatsApp beberapa menit setelah Duitku menerima pembayaran kamu.">Payment confirmation is sent by email and WhatsApp within minutes after Duitku receives your payment.</p>
      <a class="help-link mono" href={playstore.whatsapp} target="_blank" rel="noopener noreferrer">WHATSAPP SUPPORT ↗</a>
    </div>
  </section>
</Layout>

<script>
  import '../../scripts/reveal.ts';
  import '../../scripts/cursor.ts';
  import '../../scripts/scroll-progress.ts';
  import '../../scripts/impossible-checkbox.ts';
  import '../../scripts/playstore-status.ts';
</script>

<style>
  .status-section { min-height: calc(100vh - 84px); padding: clamp(60px, 9vh, 120px) 0 90px; }
  .status-shell { max-width: 820px; }
  .status-eyebrow { display: flex; align-items: center; gap: 12px; color: var(--muted); max-width: 350px; margin-bottom: 36px; }
  .chapter-num { color: var(--accent); }
  .chapter-rule { flex: 1; height: 1px; background: var(--line); }
  .status-card { border: 1px solid var(--line); border-radius: 22px; overflow: hidden; background: linear-gradient(155deg, rgba(184,255,61,.06), transparent 45%), var(--surface); box-shadow: 0 30px 90px rgba(0,0,0,.3); }
  .card-head { display: flex; justify-content: space-between; padding: 16px 22px; border-bottom: 1px solid var(--line); color: var(--muted); }
  .card-id { color: var(--accent); }
  .status-body { min-height: 280px; padding: 44px 30px; display: grid; align-content: center; }
  .status-loading { display: grid; justify-items: center; gap: 20px; color: var(--muted); font-size: 13px; }
  .status-loading p { margin: 0; }
  .spinner { width: 30px; height: 30px; border: 2px solid var(--line); border-top-color: var(--accent); border-radius: 50%; animation: spin .8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .state { display: grid; gap: 16px; justify-items: start; }
  .state-mark { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--accent); color: var(--accent); font-size: 20px; }
  .state-mark.pending { border-color: var(--muted); color: var(--muted); }
  .state-mark.failed { border-color: var(--red); color: var(--red); }
  .state-title { font-size: clamp(26px, 4vw, 42px); font-weight: 800; letter-spacing: -.06em; line-height: 1; margin: 0; }
  .state-desc { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.7; max-width: 560px; }
  .state-list { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 9px; }
  .state-list li { position: relative; padding-left: 18px; font-size: 12px; color: var(--paper); }
  .state-list li::before { content: "↳"; position: absolute; left: 0; color: var(--accent); }
  .card-foot { border-top: 1px solid var(--line); }
  .foot-row { display: flex; justify-content: space-between; gap: 16px; padding: 13px 22px; border-bottom: 1px solid var(--line); }
  .foot-row:last-child { border-bottom: 0; }
  .foot-row span { color: var(--muted); font-size: 8px; }
  .foot-row strong { font-size: 10px; font-weight: 500; letter-spacing: .04em; }
  .status-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
  .btn { display: inline-flex; align-items: center; gap: 10px; padding: 13px 18px; border: 1px solid var(--accent); font-size: 10px; letter-spacing: .06em; text-transform: uppercase; cursor: pointer; transition: background .25s var(--ease), color .25s var(--ease), border-color .25s var(--ease); }
  .btn-solid { background: var(--accent); color: #0a0a0a; }
  .btn-solid:hover { background: var(--paper); border-color: var(--paper); }
  .btn-ghost { border-color: var(--line); color: var(--muted); background: transparent; }
  .btn-ghost:hover { border-color: var(--muted); color: var(--paper); }
  .help-line { margin: 34px 0 10px; color: var(--muted); font-size: 12px; line-height: 1.6; }
  .help-link { color: var(--accent); font-size: 9px; }
  :global(body.theme-light) .status-card { background: rgba(255,255,255,.5); }
  @media (max-width: 800px) {
    .status-section { padding: 54px 0 70px; }
    .status-body { min-height: 240px; padding: 34px 20px; }
  }
  @media (prefers-reduced-motion: reduce) { .spinner { animation: none; } }
</style>
