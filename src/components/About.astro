---
import { site } from '../data/site';
---

<section class="section about-section" data-chapter="07">
  <div class="shell about">
    <div class="mono meta-col">
      <span class="chapter-num">07</span>
      <span class="chapter-rule" aria-hidden="true"></span>
      <span>About</span>
    </div>
    <div class="copy" data-reveal>
      <p class="t-about">
        <span data-en="I don't just" data-id="Kami tidak sekadar">I don't just</span><br />
        <span class="accent-word" data-en="write code." data-id="menulis kode.">write code.</span><br />
        <span data-en="I build systems" data-id="Kami membangun sistem">I build systems</span><br />
        <span data-en="that people" data-id="yang benar-benar">that people</span><br />
        <span class="accent-word" data-en="actually use." data-id="dipakai orang.">actually use.</span>
      </p>
      <p class="t-body about-support">
        <span data-en="Based in Indonesia. Focused on mobile and web applications. Available for selected freelance, product and collaboration work." data-id="Berbasis di Indonesia. Fokus pada aplikasi mobile dan web. Terbuka untuk freelance, produk, dan kolaborasi terpilih.">Based in Indonesia. Focused on mobile and web applications. Available for selected freelance, product and collaboration work.</span>
      </p>
    </div>
  </div>
</section>

<style>
  .section { padding: 130px 0; border-bottom: 1px solid var(--line); }
  .about {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 48px;
    align-items: start;
    padding: clamp(34px, 5vw, 76px);
    border: 1px solid var(--line);
    border-radius: 26px;
    background:
      radial-gradient(circle at 86% 16%, var(--accent-soft), transparent 28%),
      var(--surface);
    position: relative;
    overflow: hidden;
  }
  .about::after {
    content: "07";
    position: absolute;
    right: -10px;
    bottom: -70px;
    font-size: 250px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -.12em;
    color: rgba(255,255,255,.025);
    pointer-events: none;
  }
  .meta-col {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--muted);
  }
  .chapter-num { color: var(--paper); }
  .chapter-rule { flex: 1; height: 1px; background: var(--line); }
  .copy { max-width: 1100px; }
  .accent-word { color: var(--accent); }
  .about-support { max-width: 540px; margin-top: 32px; color: var(--muted); font-size: 12px; font-family: "DM Mono", monospace; letter-spacing: 0; line-height: 1.7; }

  @media (max-width: 800px) {
    .section { padding: 82px 0; }
    .about { grid-template-columns: 1fr; gap: 28px; border-radius: 18px; }
  }
</style>
