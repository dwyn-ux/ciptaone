---
import { site } from '../data/site';
import OrbitalSystem from './OrbitalSystem.astro';
---

<section class="hero" id="top">
  <div class="shell hero-inner">
    <div class="hero-main">
      <div class="hero-eyebrow mono">{site.tagline} · {site.domain}</div>

      <h1 class="t-display hero-title">
        <span class="hero-line"><i>BUILD</i></span>
        <span class="hero-line"><i>DIGITAL</i></span>
        <span class="hero-line accent"><i>SYSTEMS.</i></span>
      </h1>

      <p class="hero-sub t-body">
        I design and build mobile &amp; web products around real problems — from school
        systems and attendance to focused digital products.
      </p>

      <div class="hero-cta">
        <a class="cta" href="#work" data-magnetic data-cursor="VIEW">
          <span>Selected work</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <a class="cta cta-ghost" href="#contact" data-magnetic data-cursor="OPEN">
          <span>Contact</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <aside class="hero-side">
      <div class="orbit-frame" data-orbital>
        <OrbitalSystem />
      </div>
      <div class="availability mono">
        <span class="dot" aria-hidden="true"></span>
        <span>AVAILABLE FOR SELECTED PROJECTS</span>
      </div>
    </aside>
  </div>
  <span class="chapter-tag" aria-hidden="true">01</span>
</section>

<style>
  .hero {
    min-height: calc(100vh - 76px);
    padding: 9vh 0 56px;
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: hidden;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    gap: 56px;
    align-items: end;
  }
  .hero-main { max-width: 1200px; }
  .hero-eyebrow {
    color: var(--accent);
    margin-bottom: 28px;
    font-size: 11px;
  }
  .hero-title { color: var(--paper); }
  .hero-sub {
    max-width: 460px;
    margin: 36px 0 32px;
  }
  .hero-cta { display: flex; gap: 18px; flex-wrap: wrap; }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 22px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--paper);
    font-size: 12px;
    letter-spacing: .04em;
    text-transform: uppercase;
    transition: border-color .25s var(--ease), color .25s var(--ease), background .25s var(--ease);
  }
  .cta:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .cta-ghost { color: var(--muted); }
  .cta .arrow { transition: transform .35s var(--ease); display: inline-block; }
  .cta:hover .arrow { transform: translate(3px, -3px); }

  .hero-side {
    border-left: 1px solid var(--line);
    padding: 8px 0 8px 28px;
    margin-bottom: 6px;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .orbit-frame {
    width: 100%;
    aspect-ratio: 3 / 2;
    max-width: 420px;
    align-self: end;
    pointer-events: none;
  }
  .orbit-frame :global(svg) { width: 100%; height: 100%; }
  .availability {
    display: flex;
    gap: 10px;
    align-items: center;
    color: #c8c5bc;
  }

  @media (max-width: 1024px) {
    .hero-inner { grid-template-columns: 1fr; gap: 36px; }
    .hero-side { border-left: 0; border-top: 1px solid var(--line); padding: 22px 0 0; }
    .orbit-frame { max-width: 320px; margin: 0 auto; opacity: .9; }
  }
  @media (max-width: 800px) {
    .hero { padding: 64px 0 36px; min-height: auto; }
    .hero-sub { font-size: 14px; }
  }
</style>
