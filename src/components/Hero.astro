---
import { site } from '../data/site';
import OrbitalSystem from './OrbitalSystem.astro';
---

<section class="hero" id="top">
  <div class="shell hero-inner">
    <div class="hero-text">
      <div class="hero-eyebrow mono">{site.tagline} · {site.domain}</div>

      <h1 class="t-display hero-title">
        <span class="hero-line"><i>BUILD</i></span>
        <span class="hero-line"><i>DIGITAL</i></span>
        <span class="hero-line accent"><i>SYSTEMS.</i></span>
      </h1>

      <p class="hero-sub t-body" data-en="I design and build mobile &amp; web products around real problems — from school systems and attendance to focused digital products." data-id="Kami merancang dan membangun produk mobile &amp; web dari masalah nyata — dari sistem sekolah dan absensi hingga produk digital yang terfokus.">
        I design and build mobile &amp; web products around real problems — from school systems and attendance to focused digital products.
      </p>

      <div class="hero-cta">
        <a class="cta" href="#work" data-magnetic data-cursor="VIEW">
          <span data-en="Selected work" data-id="Karya pilihan">Selected work</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <a class="cta cta-ghost" href="#contact" data-magnetic data-cursor="OPEN">
          <span data-en="Contact" data-id="Kontak">Contact</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="hero-facts" aria-label="Cipta One highlights">
        <div class="fact"><strong>06</strong><span class="mono" data-en="Selected systems" data-id="Sistem pilihan">Selected systems</span></div>
        <div class="fact"><strong>02</strong><span class="mono" data-en="Core disciplines" data-id="Keahlian utama">Core disciplines</span></div>
        <div class="fact"><strong>ID</strong><span class="mono">Indonesia / Remote</span></div>
      </div>
    </div>

    <div class="hero-radar">
      <div class="radar-bar mono">
        <span>PRODUCT COMMAND</span>
        <span class="radar-id">C1 / 2026</span>
      </div>
      <div class="orbit-frame" data-orbital>
        <OrbitalSystem />
      </div>
      <div class="system-readout" aria-label="System capabilities">
        <div>
          <span class="mono">01 / STRATEGY</span>
          <strong data-en="Problem first" data-id="Masalah lebih dulu">Problem first</strong>
        </div>
        <div>
          <span class="mono">02 / DELIVERY</span>
          <strong data-en="Built to ship" data-id="Siap untuk dirilis">Built to ship</strong>
        </div>
      </div>
      <div class="availability mono">
        <span class="dot" aria-hidden="true"></span>
        <span data-en="AVAILABLE FOR SELECTED PROJECTS" data-id="TERBUKA UNTUK PROYEK TERPILIH">AVAILABLE FOR SELECTED PROJECTS</span>
      </div>
    </div>
  </div>
  <span class="chapter-tag" aria-hidden="true">01</span>
</section>

<style>
  .hero {
    min-height: calc(100vh - 84px);
    padding: clamp(64px, 8vh, 104px) 0 48px;
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: clip;
  }
  .hero::before {
    content: "";
    position: absolute;
    width: min(58vw, 860px);
    aspect-ratio: 1;
    right: -22vw;
    top: -34%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(184,255,61,.16), transparent 64%);
    filter: blur(12px);
    pointer-events: none;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(380px, .85fr);
    gap: clamp(36px, 6vw, 88px);
    align-items: center;
  }
  .hero-text { max-width: 1200px; }
  .hero-radar {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-self: center;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 28px;
    background:
      linear-gradient(145deg, rgba(255,255,255,.07), transparent 42%),
      var(--surface);
    box-shadow: 0 34px 90px rgba(0,0,0,.34), inset 0 1px 0 rgba(255,255,255,.05);
  }
  .radar-bar { display: flex; justify-content: space-between; color: var(--muted); padding: 2px 6px 0; }
  .radar-id { color: var(--accent); }
  .hero-eyebrow {
    color: var(--accent);
    margin-bottom: 32px;
    font-size: 11px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .hero-eyebrow::before { content: ""; width: 34px; height: 1px; background: var(--accent); }
  .hero-title { color: var(--paper); }
  .hero-sub {
    max-width: 510px;
    margin: 34px 0 30px;
    font-size: 15px;
  }
  .hero-cta { display: flex; gap: 18px; flex-wrap: wrap; }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 22px;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: #0a0a0a;
    font-size: 12px;
    letter-spacing: .04em;
    text-transform: uppercase;
    transition: border-color .25s var(--ease), color .25s var(--ease), background .25s var(--ease);
  }
  .cta:hover {
    background: var(--paper);
    border-color: var(--paper);
    color: var(--ink);
  }
  .cta-ghost { color: var(--muted); background: transparent; border-color: var(--line); }
  .cta-ghost:hover { color: var(--paper); background: var(--surface-raised); border-color: var(--muted); }
  .cta .arrow { transition: transform .35s var(--ease); display: inline-block; }
  .cta:hover .arrow { transform: translate(3px, -3px); }

  .hero-line { display: block; }
  .orbit-frame {
    width: 100%;
    max-width: 460px;
    aspect-ratio: 1 / 1;
    pointer-events: none;
  }
  .orbit-frame :global(svg) { width: 100%; height: 100%; }
  .system-readout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--line);
    border-radius: 13px;
    overflow: hidden;
    background: rgba(255,255,255,.025);
  }
  .system-readout div { padding: 12px 14px; display: grid; gap: 7px; }
  .system-readout div + div { border-left: 1px solid var(--line); }
  .system-readout span { color: var(--muted); font-size: 8px; }
  .system-readout strong { color: var(--paper); font-size: 13px; font-weight: 700; letter-spacing: -.04em; }
  .availability {
    display: flex;
    gap: 10px;
    align-items: center;
    color: #c8c5bc;
    padding: 15px 16px 2px;
    border-top: 1px solid var(--line);
  }
  .hero-facts {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 600px;
  }
  .fact { display: flex; flex-direction: column; gap: 5px; padding-right: 20px; }
  .fact + .fact { border-left: 1px solid var(--line); padding-left: 20px; }
  .fact strong { font-size: 24px; letter-spacing: -.06em; color: var(--paper); }
  .fact span { color: var(--muted); font-size: 9px; }

  @media (max-width: 1024px) {
    .hero-inner { grid-template-columns: 1fr; gap: 36px; }
    .hero-radar { max-width: 560px; justify-self: center; }
    .orbit-frame { max-width: 520px; }
  }
  @media (max-width: 800px) {
    .hero { padding: 54px 0 36px; min-height: auto; }
    .hero-sub { font-size: 14px; }
    .hero-eyebrow { white-space: normal; line-height: 1.55; }
    .hero-eyebrow::before { width: 22px; flex: 0 0 22px; }
    .hero-facts { margin-top: 36px; }
    .fact strong { font-size: 20px; }
    .fact { padding-right: 10px; }
    .fact + .fact { padding-left: 10px; }
  }
  @media (max-width: 480px) {
    .hero-facts { grid-template-columns: 1fr; gap: 15px; }
    .fact + .fact { border-left: 0; border-top: 1px solid var(--line); padding: 15px 0 0; }
    .hero-radar { border-radius: 18px; padding: 12px; }
    .system-readout div { padding: 10px; }
    .system-readout strong { font-size: 12px; }
  }
</style>
