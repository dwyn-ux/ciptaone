---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const slug = `project-${project.index}`;
---

<article
  class="project"
  style={`--paper:${project.paper}`}
  data-project
  data-cursor="OPEN"
  data-paper-color={project.paper}
  id={slug}
>
  <div class="project-head mono">
    <span>{project.index} / {project.category.toUpperCase()}</span>
    <span>{project.year}</span>
  </div>

  <div class="project-visual preview-follow">
    <img src={project.asset} alt={project.alt} loading="lazy" decoding="async" />
  </div>

  <div class="project-body">
    <h3 class="t-project">
      {project.title[0]}<br />{project.title[1]}
    </h3>
    <p class="t-body project-desc">{project.description}</p>
  </div>

  <a class="project-foot mono" href={project.href} aria-label={`View ${project.title.join(' ')}`}>
    <span>{project.stack}</span>
    <span class="project-cta">CASE STUDY <span class="arrow" aria-hidden="true">↗</span></span>
  </a>
</article>

<style>
  .project {
    background: var(--paper, #e9e6de);
    color: #101010;
    min-height: 620px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .project-head {
    display: flex;
    justify-content: space-between;
    color: #5f5c55;
    position: relative;
    z-index: 1;
  }
  .project-visual {
    position: absolute;
    right: 26px;
    top: 76px;
    width: 215px;
    height: 140px;
    overflow: hidden;
    transform: rotate(5deg);
    transition: transform .7s var(--ease);
    box-shadow: 16px 16px 0 rgba(0, 0, 0, .12);
    z-index: 1;
  }
  .project-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1s var(--ease), filter .6s;
  }
  .project:hover .project-visual { transform: rotate(0) scale(1.04); }
  .project:hover .project-visual img { transform: scale(1.08); filter: contrast(1.06); }

  .project-body {
    margin-top: auto;
    position: relative;
    z-index: 1;
  }
  .t-project {
    margin: 0 0 22px;
    transition: transform .6s var(--ease);
  }
  .project-desc {
    max-width: 460px;
    color: #4f4d48;
    margin: 0;
  }
  .project-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(0, 0, 0, .25);
    margin-top: 50px;
    padding-top: 14px;
    color: #55524c;
    transition: color .3s var(--ease);
    text-decoration: none;
    position: relative;
    z-index: 1;
  }
  .project:hover .t-project { transform: translateX(12px); }
  .project:hover .project-foot { color: #101010; }
  .arrow {
    display: inline-block;
    margin-left: 6px;
    transition: transform .5s var(--ease);
  }
  .project:hover .arrow { transform: translate(6px, -6px); }

  @media (max-width: 800px) {
    .project { min-height: 520px; }
    .project-visual { width: 175px; height: 112px; top: 70px; right: 18px; }
  }
</style>
