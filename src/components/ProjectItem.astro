---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const slug = `project-${project.index}`;
---

<article
  class="project"
  style={`--paper:${project.paper}`}
  data-project
  data-index={project.index}
  data-cursor="OPEN"
  data-paper-color={project.paper}
  id={slug}
>
  <div class="project-head mono">
    <span>{project.index} / {project.category.toUpperCase()}</span>
    <span class="project-year">{project.year}</span>
  </div>

  <div class="project-visual preview-follow">
    <span class="visual-label mono">LIVE PRODUCT PREVIEW</span>
    <img class="project-image-dark" src={project.asset} alt={project.alt} loading="lazy" decoding="async" />
    <img class="project-image-light" src={project.assetLight} alt="" loading="lazy" decoding="async" />
  </div>

  <div class="project-body">
    <div class="project-title-row">
      <h3 class="t-project">
        {project.title[0]}<br />{project.title[1]}
      </h3>
      <span class="project-index mono">0{project.index}</span>
    </div>
    <p class="t-body project-desc" data-en={project.descriptionId} data-id={project.description}>{project.descriptionId}</p>
  </div>

  <a class="project-foot mono" href={project.href} aria-label={`View ${project.title.join(' ')}`}>
    <span>{project.stack}</span>
    <span class="project-cta"><span data-en="CASE STUDY" data-id="DETAIL PROYEK">CASE STUDY</span> <span class="arrow" aria-hidden="true">↗</span></span>
  </a>
</article>

<style>
  .project {
    --card-bg: #101614;
    background:
      radial-gradient(circle at 94% 0%, rgba(184,255,61,.13), transparent 29%),
      var(--card-bg);
    color: var(--paper);
    min-height: 0;
    padding: 18px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 24px;
    box-shadow: 0 20px 55px rgba(0,0,0,.22), inset 0 1px 0 rgba(255,255,255,.08);
    transition: transform .5s var(--ease), box-shadow .5s var(--ease);
  }
  .project[data-index="02"] { --card-bg: #101623; }
  .project[data-index="03"], .project[data-index="04"] { --card-bg: #151716; }
  .project[data-index="05"] { --card-bg: #111923; }
  .project[data-index="06"] { --card-bg: #111914; }
  .project-head {
    display: flex;
    justify-content: space-between;
    color: rgba(241,241,236,.56);
    position: relative;
    z-index: 1;
    padding: 3px 4px 14px;
  }
  .project-visual {
    position: relative;
    width: 100%;
    height: clamp(230px, 18vw, 310px);
    overflow: hidden;
    transform: none;
    transition: transform .7s var(--ease), border-color .5s var(--ease);
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,.12);
    background: #08100d;
    z-index: 1;
  }
  .project-visual::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, transparent 52%, rgba(2,7,8,.42)); z-index: 1; }
  .visual-label { position: absolute; left: 13px; bottom: 13px; z-index: 2; color: var(--paper); background: rgba(7,12,13,.78); backdrop-filter: blur(8px); padding: 7px 8px; border: 1px solid rgba(255,255,255,.13); border-radius: 999px; font-size: 8px; }
  .project-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1s var(--ease), filter .6s;
  }
  .project-visual .project-image-light { display: none; }
  .project:hover { transform: translateY(-8px); border-color: rgba(184,255,61,.42); box-shadow: 0 30px 70px rgba(0,0,0,.34), inset 0 1px 0 rgba(255,255,255,.13); }
  .project:hover .project-visual { transform: scale(.985); border-color: rgba(184,255,61,.34); }
  .project:hover .project-visual img { transform: scale(1.035); filter: contrast(1.03) saturate(1.08); }

  .project-body {
    margin-top: 22px;
    position: relative;
    z-index: 1;
  }
  .project-title-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .t-project {
    margin: 0 0 16px;
    font-size: clamp(43px, 4.6vw, 72px);
    line-height: .82;
    color: var(--paper);
    transition: transform .6s var(--ease);
  }
  .project-index { color: var(--accent); padding-top: 5px; }
  .project-desc {
    max-width: 520px;
    color: rgba(241,241,236,.66);
    margin: 0;
  }
  .project-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255,255,255,.13);
    margin-top: 26px;
    padding: 15px 3px 3px;
    color: rgba(241,241,236,.56);
    transition: color .3s var(--ease);
    text-decoration: none;
    position: relative;
    z-index: 1;
  }
  .project:hover .t-project { transform: translateX(7px); }
  .project:hover .project-foot { color: var(--paper); }
  .arrow {
    display: inline-block;
    margin-left: 6px;
    transition: transform .5s var(--ease);
  }
  .project:hover .arrow { transform: translate(6px, -6px); }

  /* The artwork stays cinematic, while the card itself follows the page theme. */
  :global(body.theme-light) .project {
    --card-bg: #f7f3e9 !important;
    --paper: #1a1d16 !important;
    background:
      radial-gradient(circle at 94% 0%, rgba(101,143,47,.16), transparent 31%),
      var(--card-bg);
    border-color: rgba(26,29,22,.18);
    box-shadow: 0 20px 48px rgba(56,65,42,.12), inset 0 1px 0 rgba(255,255,255,.9);
  }
  :global(body.theme-light) .project[data-index="02"] { --card-bg: #f0f3eb !important; }
  :global(body.theme-light) .project[data-index="03"],
  :global(body.theme-light) .project[data-index="04"] { --card-bg: #f5f1e7 !important; }
  :global(body.theme-light) .project[data-index="05"] { --card-bg: #eef2e9 !important; }
  :global(body.theme-light) .project[data-index="06"] { --card-bg: #f2f4e9 !important; }
  :global(body.theme-light) .project-head { color: #62685d; }
  :global(body.theme-light) .project-visual { border-color: rgba(26,29,22,.24); }
  :global(body.theme-light) .project-visual .project-image-dark { display: none; }
  :global(body.theme-light) .project-visual .project-image-light { display: block; }
  :global(body.theme-light) .visual-label {
    color: #1a1d16;
    background: rgba(255,255,255,.88);
    border-color: rgba(26,29,22,.15);
  }
  :global(body.theme-light) .project-desc { color: #41483b; }
  :global(body.theme-light) .project-foot {
    border-top-color: rgba(26,29,22,.18);
    color: #62685d;
  }
  :global(body.theme-light) .project:hover {
    border-color: rgba(74,106,31,.55);
    box-shadow: 0 28px 58px rgba(56,65,42,.18), inset 0 1px 0 rgba(255,255,255,.9);
  }
  :global(body.theme-light) .project:hover .project-foot { color: #1a1d16; }

  @media (max-width: 800px) {
    .project { padding: 14px; }
    .project-visual { height: 230px; }
    .t-project { font-size: clamp(42px, 12vw, 58px); }
  }
</style>
