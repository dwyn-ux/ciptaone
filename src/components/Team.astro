---
import { site } from '../data/site';
import SectionHeader from './SectionHeader.astro';
---

<section id="team" class="section team-section" data-chapter="02">
  <div class="shell">
    <SectionHeader
      number="02"
      title="TEAM"
      titleId="TIM"
      description="A small product team — design and engineering side by side."
      descriptionId="Tim produk kecil — desain dan engineering berjalan berdampingan."
    />

    <div class="team-grid" data-reveal>
      {site.team.map((member) => (
        <article class="team-card">
          <header class="team-head">
            <span class="mono team-role" data-en={member.role} data-id={member.roleId}>{member.role}</span>
          </header>
          <h3 class="t-name">{member.name}</h3>
          <p class="t-body team-bio" data-en={member.bio} data-id={member.bioId}>{member.bio}</p>
          <ul class="team-stack mono">
            {member.stack.map((tech) => (
              <li>{tech}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .team-section { padding: 130px 0; border-bottom: 1px solid var(--line); }
  .team-grid {
    margin-top: 64px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  .team-card {
    min-height: 390px;
    padding: 34px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 18px;
    position: relative;
    overflow: hidden;
    transition: background .35s var(--ease), transform .45s var(--ease), border-color .35s;
  }
  .team-card::after {
    position: absolute;
    right: -5px;
    bottom: -32px;
    font-size: 170px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -.1em;
    color: rgba(255,255,255,.025);
    pointer-events: none;
  }
  .team-card:first-child::after { content: "01"; }
  .team-card:last-child::after { content: "02"; }
  .team-card:hover { background: var(--accent); border-color: var(--accent); transform: translateY(-8px); }
  .team-card:hover .team-role,
  .team-card:hover .team-bio,
  .team-card:hover .team-stack li,
  .team-card:hover .t-name { color: var(--ink); }

  .team-head { display: flex; justify-content: space-between; align-items: center; }
  .team-role { color: var(--muted); font-size: 10px; border: 1px solid var(--line); border-radius: 999px; padding: 8px 11px; }

  .t-name {
    margin: 0;
    font: 800 clamp(48px, 6vw, 88px)/.9 "Manrope", system-ui, sans-serif;
    letter-spacing: -.04em;
    color: var(--paper);
  }
  .team-bio { color: var(--muted); margin: auto 0 0; max-width: 460px; }
  .team-stack {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    color: var(--muted);
  }

  body.theme-light .t-name { color: #1A1A18; }
  body.theme-light .team-bio { color: #3d3d38; }
  body.theme-light .team-stack { color: #3d3d38; }
  body.theme-light .team-role { color: #6a6a64; }
  body.theme-light .team-section { border-bottom-color: var(--line); }
  body.theme-light .team-grid { border-color: var(--line); }
  body.theme-light .team-card { border-color: var(--line); }

  @media (max-width: 800px) {
    .team-grid { grid-template-columns: 1fr; }
    .team-card { min-height: 340px; }
  }
</style>
