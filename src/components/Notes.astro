---
import { notes } from '../data/stack';
---

<section id="notes" class="section" data-chapter="05">
  <div class="shell">
    <header class="section-header" data-reveal>
      <div class="grid">
        <div class="meta">
          <span class="mono chapter-num">05</span>
          <span class="mono chapter-rule" aria-hidden="true"></span>
          <span class="mono chapter-label">Engineering notes</span>
        </div>
        <h2 class="t-section">Thinking out loud about software, products and the decisions behind them.</h2>
      </div>
    </header>

    <div class="notes">
      {notes.map((note) => (
        <a class="note" href={note.href} data-reveal data-cursor="OPEN">
          <span class="mono">{note.index} / {note.group.toUpperCase()}</span>
          <h3 class="t-section note-title">{note.title}</h3>
          <span class="note-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .section { padding: 130px 0; border-bottom: 1px solid var(--line); }
  .section-header { margin-bottom: 65px; }
  .grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 32px;
    align-items: start;
  }
  .meta { display: flex; align-items: center; gap: 12px; color: var(--muted); }
  .chapter-num { color: var(--paper); }
  .chapter-rule { flex: 1; height: 1px; background: var(--line); position: relative; overflow: hidden; }
  .chapter-rule::after {
    content: "";
    position: absolute;
    left: -25%; top: 0;
    width: 25%; height: 100%;
    background: var(--accent);
    animation: scan 3.2s linear infinite;
  }
  @keyframes scan { to { left: 110%; } }

  .notes { display: grid; grid-template-columns: 1fr 1fr; }
  .note {
    position: relative;
    overflow: hidden;
    min-height: 220px;
    padding: 26px;
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    color: var(--paper);
    transition: background .4s var(--ease), color .4s var(--ease);
  }
  .note:nth-child(odd) { border-right: 1px solid var(--line); }
  .note:hover { background: var(--paper); color: var(--ink); }
  .note:hover .mono { color: #55524c; }
  .note-title {
    margin: 48px 0 0;
    max-width: 620px;
  }
  .note-arrow {
    position: absolute;
    right: 26px;
    top: 22px;
    font-size: 26px;
    transform: translate(14px, -14px) rotate(-15deg);
    opacity: 0;
    transition: opacity .45s var(--ease), transform .45s var(--ease);
  }
  .note:hover .note-arrow { opacity: 1; transform: none; }

  @media (max-width: 800px) {
    .section { padding: 82px 0; }
    .grid { grid-template-columns: 1fr; gap: 18px; }
    .section-header { margin-bottom: 40px; }
    .notes { grid-template-columns: 1fr; }
    .note:nth-child(odd) { border-right: 0; }
  }
</style>
