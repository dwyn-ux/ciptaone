---
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 900 600"
  fill="none"
  role="img"
  aria-label="Cipta One radar sweep"
  class="orbital-svg"
>
  <g class="cross" stroke-width="1">
    <line x1="60" y1="300" x2="840" y2="300"/>
    <line x1="450" y1="40" x2="450" y2="560"/>
  </g>
  <g class="cross-text" font-family="DM Mono, monospace" font-size="10" letter-spacing="1">
    <text x="64" y="294">N 00.000</text>
    <text x="836" y="294" text-anchor="end">E 00.000</text>
    <text x="460" y="52">SYS / 001</text>
    <text x="460" y="568">CORE STABLE</text>
  </g>

  <g class="rings">
    <circle cx="450" cy="300" r="80" class="ring"/>
    <circle cx="450" cy="300" r="150" class="ring ring-faint"/>
    <circle cx="450" cy="300" r="220" class="ring ring-faint"/>
  </g>

  <g class="sweep">
    <path d="M450 300 L450 80 A220 220 0 0 1 670 300 Z" class="sweep-fan"/>
  </g>

  <g class="blips">
    <circle cx="560" cy="240" r="3" class="blip blip-a"/>
    <circle cx="380" cy="360" r="3" class="blip blip-b"/>
    <circle cx="520" cy="380" r="3" class="blip blip-c"/>
  </g>

  <circle cx="450" cy="300" r="6" class="core"/>
  <circle cx="450" cy="300" r="3" class="core-inner"/>

  <g class="meta-text" font-family="DM Mono, monospace" font-size="9" letter-spacing="1.5">
    <text x="64" y="40">/ RADAR · SWEEP 001</text>
    <text x="64" y="572">RX 0.000 · RY 0.000 · RPM 0.6</text>
    <text x="836" y="572" text-anchor="end">© CIPTA ONE</text>
  </g>
</svg>

<style>
  .orbital-svg { display: block; color: var(--accent); }
  .orbital-svg .cross { stroke: var(--line); }
  .orbital-svg .cross-text { fill: var(--muted); }
  .orbital-svg .ring { stroke: var(--accent); fill: none; stroke-width: 1; }
  .orbital-svg .ring-faint { stroke-opacity: .35; }
  .orbital-svg .core { fill: var(--accent); stroke: none; }
  .orbital-svg .core-inner { fill: var(--paper); stroke: none; }
  .orbital-svg .meta-text { fill: var(--muted); }

  .orbital-svg .sweep { transform-origin: 450px 300px; animation: radarSpin 5s linear infinite; }
  .orbital-svg .sweep-fan {
    fill: var(--accent);
    fill-opacity: .18;
    stroke: var(--accent);
    stroke-opacity: .55;
    stroke-width: 1;
  }
  @keyframes radarSpin { to { transform: rotate(360deg); } }

  .orbital-svg .blip { fill: var(--accent); stroke: none; opacity: 0; }
  .orbital-svg .blip-a { animation: blip 5s linear infinite; }
  .orbital-svg .blip-b { animation: blip 5s linear infinite; animation-delay: 1.6s; }
  .orbital-svg .blip-c { animation: blip 5s linear infinite; animation-delay: 3.2s; }
  @keyframes blip {
    0%, 8% { opacity: 0; }
    10% { opacity: 1; }
    25% { opacity: 0; }
    100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbital-svg .sweep { animation: none; }
    .orbital-svg .blip { animation: none; opacity: 1; }
  }
</style>
