---
import { site } from '../data/site';
---

<section id="contact" class="section contact-section" data-chapter="07">
  <div class="shell contact">
    <div class="mono contact-tag">
      <span class="chapter-num">07</span>
      <span class="chapter-rule" aria-hidden="true"></span>
      <span>Start a project</span>
    </div>

    <h2 class="t-contact">
      <span class="line">HAVE SOMETHING</span>
      <span class="line indent">WORTH BUILDING?</span>
      <span class="line accent-line">LET'S TALK.</span>
    </h2>

    <div class="contact-bottom">
      <a
        class="email"
        href={`mailto:${site.email}`}
        data-magnetic
        data-cursor="OPEN"
      >
        <span>{site.email}</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>

      <ul class="socials">
        {site.socials.map((s) => (
          <li>
            <a href={s.href} data-cursor="OPEN" rel="noopener noreferrer">
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .contact-section { padding: 120px 0 80px; min-height: 88vh; }
  .contact {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
  }
  .contact-tag {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--muted);
    max-width: 320px;
  }
  .chapter-num { color: var(--paper); }
  .chapter-rule { flex: 1; height: 1px; background: var(--line); }

  .t-contact { margin: 0; color: var(--paper); }
  .line { display: block; }
  .indent { margin-left: 12vw; }
  .accent-line { color: var(--accent); transition: transform .8s var(--ease); }
  .contact:hover .accent-line { transform: translateX(3vw); }

  .contact-bottom {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    flex-wrap: wrap;
  }
  .email {
    font-size: 22px;
    border-bottom: 1px solid #777;
    padding-bottom: 8px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: border-color .3s var(--ease), color .3s var(--ease);
  }
  .email:hover { border-color: var(--accent); color: var(--accent); }
  .arrow { display: inline-block; transition: transform .4s var(--ease); }
  .email:hover .arrow { transform: translate(4px, -4px); }
  .socials {
    list-style: none;
    margin: 0; padding: 0;
    display: flex;
    gap: 22px;
    color: var(--muted);
  }
  .socials a {
    font: 500 10px/1.3 "DM Mono", monospace;
    letter-spacing: .08em;
    text-transform: uppercase;
    transition: color .25s var(--ease);
  }
  .socials a:hover { color: var(--accent); }

  @media (max-width: 800px) {
    .contact-section { min-height: 75vh; padding: 64px 0 56px; }
    .indent { margin-left: 0; }
    .contact-bottom { flex-direction: column; align-items: flex-start; }
    .socials { margin-top: 12px; }
  }
</style>
