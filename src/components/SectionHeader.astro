---
interface Props {
  number: string;
  title: string;
  titleId?: string;
  description?: string;
  descriptionId?: string;
}
const { number, title, titleId, description, descriptionId } = Astro.props;
---

<header class="section-header" data-reveal>
  <div class="grid">
    <div class="meta">
      <span class="mono chapter-num">{number}</span>
      <span class="mono chapter-rule" aria-hidden="true"></span>
      <span class="mono chapter-label" data-en={title} data-id={titleId ?? title}>{title}</span>
    </div>
    {description && (
      <h2 class="t-section" data-en={description} data-id={descriptionId ?? description}>{description}</h2>
    )}
  </div>
</header>

<style>
  .section-header { margin-bottom: 72px; }
  .grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 32px;
    align-items: start;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--muted);
    padding: 9px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
  }
  .chapter-num { color: var(--paper); }
  .chapter-rule {
    flex: 1;
    height: 1px;
    background: var(--line);
    position: relative;
    overflow: hidden;
  }
  .chapter-rule::after {
    content: "";
    position: absolute;
    left: -25%;
    top: 0;
    width: 25%;
    height: 100%;
    background: var(--accent);
    animation: scan 3.2s linear infinite;
  }
  .chapter-label { color: var(--muted); }
  .t-section { max-width: 900px; margin: -4px 0 0; text-wrap: balance; }
  @media (max-width: 800px) {
    .section-header { margin-bottom: 40px; }
    .grid { grid-template-columns: 1fr; gap: 18px; }
  }
</style>
