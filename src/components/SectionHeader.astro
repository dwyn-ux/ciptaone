---
interface Props {
  number: string;
  title: string;
  description?: string;
}
const { number, title, description } = Astro.props;
---

<header class="section-header" data-reveal>
  <div class="grid">
    <div class="meta">
      <span class="mono chapter-num">{number}</span>
      <span class="mono chapter-rule" aria-hidden="true"></span>
      <span class="mono chapter-label">{title}</span>
    </div>
    {description && (
      <h2 class="t-section">{description}</h2>
    )}
  </div>
</header>

<style>
  .section-header { margin-bottom: 65px; }
  .grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 32px;
    align-items: start;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--muted);
  }
  .chapter-num { color: var(--paper); }
  .chapter-rule {
    flex: 1;
    height: 1px;
    background: var(--line);
    position: relative;
    overflow: hidden;
  }
  .chapter-rule::after {
    content: "";
    position: absolute;
    left: -25%;
    top: 0;
    width: 25%;
    height: 100%;
    background: var(--accent);
    animation: scan 3.2s linear infinite;
  }
  .chapter-label { color: var(--muted); }
  @media (max-width: 800px) {
    .section-header { margin-bottom: 40px; }
    .grid { grid-template-columns: 1fr; gap: 18px; }
  }
</style>
