    </div>

    <div class="icbx-arm-wrap" data-icbx-arm-wrap>
      <svg class="icbx-arm" data-icbx-arm viewBox="0 0 250.00001 99.999997" preserveAspectRatio="xMinYMin">
        <g transform="translate(868.57141,-900.93359)">
          <path d="m -619.43416,945.05124 c 4.18776,73.01076 -78.25474,53.24342 -150.21568,52.94118 -82.38711,-0.34602 -98.92158,-19.44459 -98.92157,-47.05883 0,-27.61424 4.78794,-42.54902 73.82353,-42.54902 69.03559,0 171.43607,-30.93764 175.31372,36.66667 z" fill="#784421"/>
