---
// Impossible Checkbox — vanilla port of jh3y's bear pen.
// Web Animations API instead of GSAP, no React. Single inline SVG, no assets.
---

<section class="section icbx-section" data-chapter="04b">
  <div class="shell">
    <header class="icbx-header" data-reveal>
      <div class="icbx-meta">
        <span class="mono">04b — Try this</span>
        <span class="icbx-rule" aria-hidden="true"></span>
        <span class="mono">A small experiment</span>
      </div>
      <p class="icbx-copy">
        A switch you can flip. Don't worry — the bear
        <span class="icbx-accent">doesn't bite back</span>.
      </p>
    </header>

    <div class="icbx-stage" data-reveal>
      <div class="icbx" data-icbx>

