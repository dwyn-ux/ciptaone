<style>
  /* Bear scene: fixed overlay, hidden until trigger */
  .icbx-scene {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 80;
    opacity: 0;
    transition: opacity .2s;
  }
  .icbx-scene.is-active { opacity: 1; }

  /* Bear anchored under header switch (top-right corner). Tiny — 7x smaller than jh3y original. */
  .icbx-bear-wrap {
    position: absolute;
    right: 28px;
    top: 76px;
    width: 16px;
    transform: translate(0, 0) rotate(5deg);
    will-change: transform;
  }
  .icbx-bear {
    width: 100%;
    height: auto;
    display: block;
    background: transparent;
    transform: translate(0, 100%);
    will-change: transform;
  }
  .icbx-swear {
    display: none;
    position: absolute;
    left: 105%;
    top: 0;
    background: var(--paper, #F1F1EC);
    color: var(--ink, #0A0A0A);
    font-weight: 800;
    padding: 6px 10px;
    border-radius: 6px;
    font-family: "DM Mono", monospace;
    font-size: 10px;
    letter-spacing: .05em;
    white-space: nowrap;
  }
  .icbx-swear::before {
    content: "";
    position: absolute;
    top: 90%;
    right: 70%;
    height: 18px;
    width: 18px;
    background: var(--paper, #F1F1EC);
    clip-path: polygon(0 100%, 100% 0, 50% 0);
    -webkit-clip-path: polygon(0 100%, 100% 0, 50% 0);
  }
  .icbx-arm-wrap {
    position: absolute;
    height: 6px;
    width: 16px;
    top: 76px;
    right: 28px;
    transform: translate(0, 0);
  }
  .icbx-arm {
    background: transparent;
    transform-origin: left;
    position: absolute;
    height: 100%;
    width: 100%;
    top: 50%;
    left: 50%;
    transform: translate(-35%, -50%) scaleX(1);
    will-change: transform;
  }
  .icbx-paw {
    background: #784421;
    border-radius: 100%;
    position: absolute;
    height: 5px;
    width: 5px;
    top: 76px;
    right: 28px;
    transform-origin: right;
    transform: translate(-12px, 0) scaleX(0);
    will-change: transform;
  }

  @media (max-width: 800px) {
    .icbx-bear-wrap { right: 6px; top: 64px; width: 14px; }
    .icbx-arm-wrap { right: 6px; top: 64px; width: 14px; }
    .icbx-paw { right: 6px; top: 64px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .icbx-bear, .icbx-arm, .icbx-paw {
      transition: none !important;
    }
  }
</style>
