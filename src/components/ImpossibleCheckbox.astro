        </g>
      </svg>
    </div>

    <div class="icbx-paw" data-icbx-paw></div>
  </div>
</section>

<style>
  .icbx-section {
    padding: 80px 0;
    border-bottom: 1px solid var(--line);
    position: relative;
  }
  .icbx-row {
    width: min(1480px, 100%);
    margin: auto;
    padding: 0 34px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
  }
  .icbx-tag { color: var(--muted); }
  .icbx-hint { color: var(--muted); margin-right: 4px; }

  /* Tiny switch in the corner */
  .icbx-switch {
    position: relative;
    width: 44px;
    height: 22px;
    border-radius: 999px;
    display: inline-block;
    cursor: pointer;
    flex-shrink: 0;
  }
  .icbx-switch input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
    z-index: 2;
  }
  .icbx-switch-bg {
    position: absolute;
    inset: 0;
    background: #4a4a4a;
    border-radius: 999px;
    transition: background .25s cubic-bezier(.22, 1, .36, 1);
  }
  .icbx-switch-knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--paper, #F1F1EC);
    transition: transform .25s cubic-bezier(.22, 1, .36, 1);
    will-change: transform;
  }
  .icbx-switch input:checked ~ .icbx-switch-bg {
    background: var(--accent, #B8FF3D);
  }
  .icbx-switch input:checked ~ .icbx-switch-knob {
    transform: translateX(22px);
  }

  /* Bear scene: hidden off-screen until trigger */
  .icbx-scene {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 80;
    opacity: 0;
    transition: opacity .2s;
  }
  .icbx-scene.is-active { opacity: 1; }

  .icbx-bear-wrap {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 240px;
    transform: translate(-15%, -50%) rotate(5deg) translate(0, -75%);
    will-change: transform;
  }
  .icbx-bear {
    width: 100%;
    height: auto;
    display: block;
    background: transparent;
    transform: translate(0, 100%);
    will-change: transform;
  }
  .icbx-swear {
    display: none;
    position: absolute;
    left: 105%;
    top: 0;
    background: var(--paper, #F1F1EC);
    color: var(--ink, #0A0A0A);
    font-weight: 800;
    padding: 8px 12px;
    border-radius: 8px;
    font-family: "DM Mono", monospace;
    font-size: 12px;
    letter-spacing: .05em;
  }
  .icbx-swear::before {
    content: "";
    position: absolute;
    top: 90%;
    right: 70%;
    height: 28px;
    width: 28px;
    background: var(--paper, #F1F1EC);
    clip-path: polygon(0 100%, 100% 0, 50% 0);
    -webkit-clip-path: polygon(0 100%, 100% 0, 50% 0);
  }
  .icbx-arm-wrap {
    position: absolute;
    height: 60px;
    width: 180px;
    top: 50%;
    left: 50%;
    transform: translate(0, -50%);
  }
  .icbx-arm {
    background: transparent;
    transform-origin: left;
    position: absolute;
    height: 100%;
    width: 100%;
    top: 50%;
    left: 50%;
    transform: translate(-35%, -50%) scaleX(1);
    will-change: transform;
  }
  .icbx-paw {
    background: #784421;
    border-radius: 100%;
    position: absolute;
    height: 30px;
    width: 30px;
    top: 50%;
    left: 50%;
    transform-origin: right;
    transform: translate(80px, -15px) scaleX(0);
    will-change: transform;
  }

  @media (max-width: 800px) {
    .icbx-row { padding: 0 18px; }
    .icbx-bear-wrap { width: 180px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .icbx-bear, .icbx-arm, .icbx-paw, .icbx-switch-knob, .icbx-switch-bg {
      transition: none !important;
    }
  }
</style>
