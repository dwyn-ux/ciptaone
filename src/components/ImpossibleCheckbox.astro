---
// Bear scene for the Impossible Checkbox (vanilla port of jh3y's pen).
// Uses jh3y's positioning verbatim (bear wrap centered in scene),
// then the whole scene is shifted + scaled to sit under the switch.
---

<div class="icbx-scene" data-icbx-scene aria-hidden="true">
  <div class="icbx-mask" aria-hidden="true"></div>

  <div class="icbx-bear-wrap" data-icbx-bear-wrap>
    <span class="icbx-swear" data-icbx-swear>#@$%*!</span>
    <svg
      class="icbx-bear"
      data-icbx-bear
      viewBox="0 0 284.94574 359.73706"
      preserveAspectRatio="xMinYMin"
    >
      <g transform="translate(-7.5271369,-761.38595)">
        <g transform="matrix(1.2335313,0,0,1.2335313,-35.029693,-212.83637)">
          <path d="M 263.90933,1081.4151 A 113.96792,96.862576 0 0 0 149.99132,985.71456 113.96792,96.862576 0 0 0 36.090664,1081.4151 l 227.818666,0 z" fill="#784421"/>
          <path d="m 250.42825,903.36218 c 2e-5,66.27108 -44.75411,114.99442 -102.42825,114.99442 -57.674143,0 -98.428271,-48.72334 -98.428251,-114.99442 4e-6,-66.27106 40.754125,-92.99437 98.428251,-92.99437 57.67413,0 102.42825,26.72331 102.42825,92.99437 z" fill="#784421"/>
          <path d="m 217,972.86218 c 2e-5,21.53911 -30.44462,42.00002 -68,42.00002 -37.55538,0 -66.000019,-20.46091 -66,-42.00002 0,-21.53911 28.44464,-36 66,-36 37.55536,0 68,14.46089 68,36 z" fill="#e9c6af"/>
          <path d="m 181.5,944.36218 c 0,8.28427 -20.59974,26.5 -32.75,26.5 -12.15026,0 -34.75,-18.21573 -34.75,-26.5 0,-8.28427 22.59974,-13.5 34.75,-13.5 12.15026,0 32.75,5.21573 32.75,13.5 z" fill="#000000"/>
          <g>
            <ellipse cx="69" cy="823.07269" rx="34.5" ry="33.289474" fill="#784421"/>
            <path d="M 69,47.310547 A 24.25,23.399124 0 0 0 44.75,70.710938 24.25,23.399124 0 0 0 64.720703,93.720703 c 0.276316,-0.40734 0.503874,-0.867778 0.787109,-1.267578 1.70087,-2.400855 3.527087,-4.666237 5.470704,-6.798828 1.943616,-2.132591 4.004963,-4.133318 6.179687,-6.003906 2.174725,-1.870589 4.461274,-3.611714 6.855469,-5.226563 2.394195,-1.614848 4.896019,-3.10338 7.498047,-4.46875 0.539935,-0.283322 1.133058,-0.500695 1.68164,-0.773437 A 24.25,23.399124 0 0 0 69,47.310547 Z" transform="translate(0,752.36216)" fill="#e9c6af"/>
          </g>
          <g transform="matrix(-1,0,0,1,300,0)">
            <ellipse ry="33.289474" rx="34.5" cy="823.07269" cx="69" fill="#784421"/>
            <path transform="translate(0,752.36216)" d="M 69,47.310547 A 24.25,23.399124 0 0 0 44.75,70.710938 24.25,23.399124 0 0 0 64.720703,93.720703 c 0.276316,-0.40734 0.503874,-0.867778 0.787109,-1.267578 1.70087,-2.400855 3.527087,-4.666237 5.470704,-6.798828 1.943616,-2.132591 4.004963,-4.133318 6.179687,-6.003906 2.174725,-1.870589 4.461274,-3.611714 6.855469,-5.226563 2.394195,-1.614848 4.896019,-3.10338 7.498047,-4.46875 0.539935,-0.283322 1.133058,-0.500695 1.68164,-0.773437 A 24.25,23.399124 0 0 0 69,47.310547 Z" fill="#e9c6af"/>
          </g>
          <ellipse ry="9.6790915" rx="9.2701159" cy="900.38916" cx="105.83063" fill="#000000"/>
          <ellipse cx="186.89894" cy="900.38916" rx="9.2701159" ry="9.6790915" fill="#000000"/>
          <g data-icbx-angry style="display:none;">
            <path d="m 92.05833,865.4614 39.42665,22.76299" stroke="#000000" stroke-width="4.86408424" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <path d="m 202.82482,865.4614 -39.42664,22.76299" stroke="#000000" stroke-width="4.86408424" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </g>
        </g>
      </g>
    </svg>
  </div>

  <div class="icbx-arm-wrap" data-icbx-arm-wrap>
    <svg class="icbx-arm" data-icbx-arm viewBox="0 0 250.00001 99.999997" preserveAspectRatio="xMinYMin">
      <g transform="translate(868.57141,-900.93359)">
        <path d="m -619.43416,945.05124 c 4.18776,73.01076 -78.25474,53.24342 -150.21568,52.94118 -82.38711,-0.34602 -98.92158,-19.44459 -98.92157,-47.05883 0,-27.61424 4.78794,-42.54902 73.82353,-42.54902 69.03559,0 171.43607,-30.93764 175.31372,36.66667 z" fill="#784421"/>
        <ellipse cx="-683.02264" cy="950.98572" rx="29.910826" ry="29.414362" fill="#e9c6af"/>
      </g>
    </svg>
  </div>

  <div class="icbx-paw" data-icbx-paw></div>
</div>

<style>
  /* Scene: fixed full-viewport, hidden by default. */
  .icbx-scene {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 80;
    opacity: 0;
    transition: opacity .2s;
  }
  .icbx-scene.is-active { opacity: 1; }

  /* Mask: jh3y signature, blocks lower half of scene. */
  .icbx-mask {
    position: fixed;
    top: 50%;
    left: 0;
    right: 0;
    bottom: 0;
    background: transparent;
  }

  /* === jh3y's positioning, verbatim (scaled 1/7 + offset to switch) === */

  /* Bear wrap: 100px wide, anchored to viewport center, rotated + raised 75%. */
  .icbx-bear-wrap {
    width: 100px;
    left: 50%;
    position: absolute;
    top: 50%;
    transform: translate(-15%, -50%) rotate(5deg) translate(0, -75%);
    background: transparent;
  }

  .icbx-bear {
    width: 100%;
    background: transparent;
    transform: translate(0, 100%);
    will-change: transform;
    overflow: visible;
  }

  /* Override SVG to use intrinsic 100px size when scene is active (so it renders at full quality). */
  .icbx-scene.is-active .icbx-bear {
    width: 100px;
    transform: translate(0, 0);
  }

  .icbx-swear {
    display: none;
    position: absolute;
    left: 105%;
    top: 0;
    background: #fff;
    font-weight: 800;
    padding: 6px 10px;
    border-radius: 6px;
    font-family: "DM Mono", monospace;
    font-size: 10px;
    letter-spacing: .05em;
    white-space: nowrap;
    color: #0A0A0A;
  }
  .icbx-swear::before {
    content: '';
    background: #fff;
    position: absolute;
    top: 90%;
    right: 70%;
    height: 18px;
    width: 18px;
    clip-path: polygon(0 100%, 100% 0, 50% 0);
    -webkit-clip-path: polygon(0 100%, 100% 0, 50% 0);
  }

  .icbx-arm-wrap {
    background: transparent;
    position: fixed;
    height: 30px;
    width: 90px;
    z-index: 4;
    top: 50%;
    left: 50%;
    transform: translate(0, -50%);
  }
  .icbx-arm {
    background: transparent;
    transform-origin: left;
    position: absolute;
    height: 100%;
    width: 100%;
    top: 50%;
    left: 50%;
    transform: translate(-35%, -50%) scaleX(1);
    will-change: transform;
  }

  .icbx-paw {
    background: #784421;
    border-radius: 100%;
    position: fixed;
    height: 30px;
    width: 30px;
    z-index: 10;
    top: 50%;
    left: 50%;
    transform-origin: right;
    transform: translate(80px, -15px) scaleX(0);
    will-change: transform;
  }

  /* Scale the whole scene contents to 1/7 so the bear is appropriately small.
     jh3y's scene is anchored to viewport center; we offset that center to switch position.
     Use a CSS variable for switch position so it scales responsively. */
  :root {
    --switch-x: 1.6em;
    --switch-y: 4.75em;
  }
  @media (max-width: 800px) {
    :root {
      --switch-x: 0.4em;
      --switch-y: 4em;
    }
  }

  /* Apply offset + scale to bear/arm/paw when scene is active. */
  .icbx-scene.is-active .icbx-bear-wrap,
  .icbx-scene.is-active .icbx-arm-wrap,
  .icbx-scene.is-active .icbx-paw {
    transform-origin: 100% 100%;
  }

  /* Override the bear wrap transform with offset+scale composition.
     The original transform is preserved inline; here we add to it via CSS animation override. */
  .icbx-scene.is-active .icbx-bear-wrap {
    /* Keep base transform, but scale via CSS zoom-like effect using transform.
       We can't simply multiply transforms in CSS without overriding the inline value.
       Solution: leave inline transform alone, but the inner SVG scales via width %. */
  }

  /* Scale all scene contents to 1/7 (~14px) by shrinking the wrappers.
     jh3y's inner values stay intact; we just resize the containers. */
  .icbx-scene.is-active .icbx-bear-wrap {
    width: 14px;
    left: auto;
    right: var(--switch-x);
    top: var(--switch-y);
    transform: translate(0, 0) rotate(5deg);
  }
  .icbx-scene.is-active .icbx-bear {
    transform: translate(0, 0);
  }

  /* Arm: 90px → ~13px, height 30px → ~4px */
  .icbx-scene.is-active .icbx-arm-wrap {
    width: 13px;
    height: 4px;
    right: var(--switch-x);
    top: var(--switch-y);
    left: auto;
    transform: translate(0, 0);
  }
  .icbx-scene.is-active .icbx-arm {
    width: 90px; /* keep SVG intrinsic size */
    height: 30px;
  }

  /* Paw: 30px → ~4px */
  .icbx-scene.is-active .icbx-paw {
    width: 4px;
    height: 4px;
    right: var(--switch-x);
    top: var(--switch-y);
    left: auto;
    transform: translate(0, 0) scaleX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .icbx-bear, .icbx-arm, .icbx-paw {
      transition: none !important;
    }
  }
</style>
