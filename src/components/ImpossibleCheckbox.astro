    <span class="icbx-checkbox-indicator" data-icbx-indicator></span>
  </label>
    </div>
  </div>
</section>

<style>
  .icbx-section { padding: 110px 0 90px; border-bottom: 1px solid var(--line); }
  .icbx-header { margin-bottom: 56px; display: grid; grid-template-columns: 200px 1fr; gap: 32px; align-items: start; }
  .icbx-meta { display: flex; align-items: center; gap: 12px; color: var(--muted); }
  .icbx-rule { flex: 1; height: 1px; background: var(--line); }
  .icbx-copy {
    font-family: "DM Mono", monospace;
    font-size: 12px;
    color: var(--muted);
    line-height: 1.7;
    margin: 0;
    max-width: 520px;
  }
  .icbx-accent { color: var(--accent); }
  .icbx-stage {
    display: flex;
    justify-content: center;
    padding: 24px 0 0;
  }

  @media (max-width: 800px) {
    .icbx-section { padding: 70px 0; }
    .icbx-header { grid-template-columns: 1fr; gap: 18px; margin-bottom: 32px; }
  }

  .icbx {
    --icbx-size: min(78vmin, 460px);
    --icbx-accent-on: var(--accent, #B8FF3D);
    --icbx-accent-off: #777;

    position: relative;
    width: var(--icbx-size);
    aspect-ratio: 1;
    margin: 32px auto 48px;
    overflow: visible;
  }

  .icbx-mask {
    position: absolute;
    inset: 0;
    background: transparent;
    pointer-events: none;
  }

  /* Bear wrapper */
  .icbx-bear-wrap {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 60%;
    transform: translate(-15%, -50%) rotate(5deg) translate(0, -75%);
    pointer-events: none;
    z-index: 1;
  }
  .icbx-bear {
    width: 100%;
    height: auto;
    display: block;
    background: transparent;
    transform: translate(0, 100%);
    will-change: transform;
  }
  .icbx-swear {
    display: none;
    position: absolute;
    left: 105%;
    top: 0;
    background: var(--paper, #F1F1EC);
    color: var(--ink, #0A0A0A);
    font-weight: 800;
    padding: 8px 12px;
    border-radius: 8px;
    font-family: "DM Mono", monospace;
    font-size: 12px;
    letter-spacing: .05em;
  }
  .icbx-swear::before {
    content: "";
    position: absolute;
    top: 90%;
    right: 70%;
    height: 28px;
    width: 28px;
    background: var(--paper, #F1F1EC);
    clip-path: polygon(0 100%, 100% 0, 50% 0);
    -webkit-clip-path: polygon(0 100%, 100% 0, 50% 0);
  }

  /* Arm + paw */
  .icbx-arm-wrap {
    position: absolute;
    height: 14%;
    width: 36%;
    z-index: 4;
    top: 50%;
    left: 50%;
    transform: translate(0, -50%) rotate(0deg);
    pointer-events: none;
  }
  .icbx-arm {
    background: transparent;
    transform-origin: left;
    position: absolute;
    height: 100%;
    width: 100%;
    top: 50%;
    left: 50%;
    transform: translate(-35%, -50%) scaleX(1);
    will-change: transform;
  }
  .icbx-paw {
    background: #784421;
    border-radius: 100%;
    position: absolute;
    height: 14%;
    width: 14%;
    z-index: 10;
    top: 50%;
    left: 50%;
    transform-origin: right;
    transform: translate(40%, -50%) scaleX(0);
    will-change: transform;
  }

  /* Checkbox (visible) */
  .icbx-checkbox {
    position: absolute;
    z-index: 5;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50px;
    height: 18%;
    width: 36%;
    display: block;
    cursor: pointer;
  }
  .icbx-checkbox input {
    cursor: pointer;
    border-radius: 50px;
    position: absolute;
    outline: 0;
    inset: 0;
    opacity: 0;
    z-index: 10;
    height: 100%;
    width: 100%;
    margin: 0;
  }
  .icbx-checkbox-bg {
    background: var(--icbx-accent-off);
    border-radius: 50px;
    height: 100%;
    width: 100%;
    z-index: 1;
    transition: background .25s cubic-bezier(.22, 1, .36, 1);
    display: block;
  }
  .icbx-checkbox-indicator {
    background: transparent;
    height: 100%;
    width: 50%;
    border-radius: 100%;
    position: absolute;
    top: 0;
    left: 0;
    transform: translateX(0);
    transition: transform .25s cubic-bezier(.22, 1, .36, 1);
    will-change: transform;
  }
  .icbx-checkbox-indicator::after {
    content: "";
    border-radius: 100%;
    height: 85%;
    width: 85%;
    background: var(--paper, #F1F1EC);
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .icbx-bear,
    .icbx-arm,
    .icbx-paw,
    .icbx-checkbox-indicator {
      transition: none !important;
    }
  }
</style>
