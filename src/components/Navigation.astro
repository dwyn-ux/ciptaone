---
import { site } from '../data/site';
import Lightbulb from './Lightbulb.astro';
import LanguageToggle from './LanguageToggle.astro';
---

<header class="nav-root">
  <div class="shell nav-inner">
    <a class="logo" href="#top" aria-label="Cipta One home">
      <img class="logo-mark" src="/assets/logo.svg" alt="" width="42" height="42" />
      <span class="logo-word">CIPTA ONE</span>
    </a>
    <nav class="nav mono" aria-label="Primary">
      {site.nav.map((item) => (
        <a href={item.href} data-cursor="VIEW" data-en={item.label} data-id={item.labelId}>{item.label}</a>
      ))}
    </nav>
    <div class="nav-actions">
      <details class="mobile-menu">
        <summary class="mono">Menu <span aria-hidden="true">+</span></summary>
        <nav aria-label="Mobile primary">
          {site.nav.map((item) => (
            <a href={item.href}><span data-en={item.label} data-id={item.labelId}>{item.label}</span><span aria-hidden="true">↗</span></a>
          ))}
        </nav>
      </details>
      <LanguageToggle />
      <a class="nav-cta mono" href="#contact" data-cursor="OPEN"><span data-en="Start a project" data-id="Mulai proyek">Start a project</span> <span>↗</span></a>
      <Lightbulb />
    </div>
  </div>
</header>

<style>
  .nav-root {
    height: 84px;
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(10, 10, 10, .72);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }
  .nav-inner {
    height: 62px;
    position: relative;
    top: 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border: 1px solid color-mix(in srgb, var(--line) 82%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    box-shadow: 0 18px 45px rgba(0,0,0,.18);
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 800;
    letter-spacing: -.06em;
    font-size: 15px;
    margin-left: 14px;
  }
  .logo-mark {
    width: 42px;
    height: 42px;
    display: block;
    object-fit: contain;
    filter: brightness(0) invert(1);
    transition: filter .4s ease;
  }
  :root {
    --logo-filter: brightness(0) invert(1);
  }
  body.theme-light .logo-mark,
  :root[style*="--on: 1"] .logo-mark {
    filter: brightness(0);
  }
  .nav {
    display: flex;
    gap: 5px;
  }
  .nav a {
    font-size: 11px;
    color: var(--muted);
    padding: 10px 13px;
    border-radius: 999px;
    transition: color .25s var(--ease), background .25s var(--ease);
  }
  .nav a:hover { color: var(--paper); background: var(--accent-soft); }
  .nav-actions { display: flex; align-items: center; gap: 14px; margin-right: 8px; }
  .nav-cta {
    color: var(--ink);
    background: var(--accent);
    padding: 10px 14px;
    border-radius: 999px;
    font-size: 9px;
    transition: transform .25s var(--ease), background .25s var(--ease);
  }
  .nav-cta span { display: inline-block; margin-left: 5px; transition: transform .25s var(--ease); }
  .nav-cta:hover { color: var(--ink); background: var(--paper); transform: translateY(-2px); }
  .nav-cta:hover span { transform: translate(2px, -2px); }
  .mobile-menu { display: none; position: relative; }
  .mobile-menu summary { list-style: none; cursor: pointer; color: var(--paper); font-size: 9px; padding: 9px 4px; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu summary span { color: var(--accent); margin-left: 3px; }
  .mobile-menu[open] summary span { display: inline-block; transform: rotate(45deg); }
  .mobile-menu nav {
    position: absolute;
    right: 0;
    top: calc(100% + 13px);
    width: min(260px, calc(100vw - 36px));
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: rgba(18,18,16,.98);
    box-shadow: 0 22px 50px rgba(0,0,0,.32);
  }
  .mobile-menu nav a { display: flex; justify-content: space-between; padding: 13px; border-radius: 11px; color: var(--paper); font-size: 10px; }
  .mobile-menu nav a:hover { color: var(--ink); background: var(--accent); }

  @media (max-width: 800px) {
    .nav-root { height: 74px; }
    .nav-inner { height: 54px; }
    .nav { display: none; }
    .mobile-menu { display: block; }
    .nav-cta { padding: 9px 11px; font-size: 8px; }
    .nav-actions { gap: 8px; margin-right: 3px; }
    .logo { margin-left: 8px; }
    .logo-mark { width: 36px; height: 36px; }
  }
</style>
