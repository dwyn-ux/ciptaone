---
import { site } from '../data/site';
---

<header class="nav-root">
  <div class="shell nav-inner">
    <a class="logo" href="#top" aria-label="Cipta One home">
      <img class="logo-mark" src="/assets/cipta.png" alt="" width="42" height="42" />
      <span class="logo-word">CIPTA ONE</span>
    </a>
    <nav class="nav mono" aria-label="Primary">
      {site.nav.map((item) => (
        <a href={item.href} data-cursor="VIEW">{item.label}</a>
      ))}
    </nav>
    <label class="icbx-switch" data-icbx aria-label="Toggle the bear">
      <span class="icbx-label mono">EXP</span>
      <input type="checkbox" data-icbx-input />
      <span class="icbx-switch-bg" data-icbx-bg aria-hidden="true"></span>
      <span class="icbx-switch-knob" data-icbx-knob aria-hidden="true"></span>
    </label>
  </div>
</header>

<style>
  .nav-root {
    height: 76px;
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(10, 10, 10, .82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 800;
    letter-spacing: -.06em;
    font-size: 15px;
    margin-left: 18px;
  }
  .logo-mark {
    width: 42px;
    height: 42px;
    display: block;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }
  .nav {
    display: flex;
    gap: 28px;
  }
  .nav a {
    font-size: 11px;
    color: #c7c4bc;
    transition: color .25s var(--ease);
  }
  .nav a:hover { color: var(--accent); }

  /* Switch (replaces ID/2026 tag) */
  .icbx-switch {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    user-select: none;
    margin-right: 18px;
  }
  .icbx-label {
    color: var(--muted);
    font-size: 10px;
    transition: color .25s var(--ease);
  }
  .icbx-switch:hover .icbx-label { color: var(--paper); }
  .icbx-switch input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
    z-index: 2;
  }
  .icbx-switch-bg {
    position: relative;
    width: 30px;
    height: 16px;
    border-radius: 999px;
    background: #4a4a4a;
    transition: background .25s cubic-bezier(.22, 1, .36, 1);
    flex-shrink: 0;
  }
  .icbx-switch-knob {
    position: absolute;
    top: 50%;
    left: 3px;
    transform: translateY(-50%);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--paper, #F1F1EC);
    transition: left .25s cubic-bezier(.22, 1, .36, 1);
    will-change: left;
    z-index: 1;
  }
  .icbx-switch input:checked ~ .icbx-switch-bg {
    background: var(--accent, #B8FF3D);
  }
  .icbx-switch input:checked ~ .icbx-switch-knob {
    left: calc(100% - 13px);
  }

  @media (max-width: 800px) {
    .nav-root { height: 64px; }
    .nav { display: none; }
    .icbx-label { display: none; }
    .icbx-switch { margin-right: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .icbx-switch-knob, .icbx-switch-bg {
      transition: none !important;
    }
  }
</style>
