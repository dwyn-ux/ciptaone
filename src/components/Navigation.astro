---
import { site } from '../data/site';
import Lightbulb from './Lightbulb.astro';
---

<header class="nav-root">
  <div class="shell nav-inner">
    <a class="logo" href="#top" aria-label="Cipta One home">
      <img class="logo-mark" src="/assets/logo.svg" alt="" width="42" height="42" />
      <span class="logo-word">CIPTA ONE</span>
    </a>
    <nav class="nav mono" aria-label="Primary">
      {site.nav.map((item) => (
        <a href={item.href} data-cursor="VIEW">{item.label}</a>
      ))}
    </nav>
    <Lightbulb />
  </div>
</header>

<style>
  .nav-root {
    height: 76px;
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(10, 10, 10, .82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 800;
    letter-spacing: -.06em;
    font-size: 15px;
    margin-left: 18px;
  }
  .logo-mark {
    width: 42px;
    height: 42px;
    display: block;
    object-fit: contain;
    filter: brightness(0) invert(1);
    transition: filter .4s ease;
  }
  :root {
    --logo-filter: brightness(0) invert(1);
  }
  body.theme-light .logo-mark,
  :root[style*="--on: 1"] .logo-mark {
    filter: brightness(0);
  }
  .nav {
    display: flex;
    gap: 28px;
  }
  .nav a {
    font-size: 11px;
    color: var(--muted);
    transition: color .25s var(--ease);
  }
  .nav a:hover { color: var(--accent); }

  @media (max-width: 800px) {
    .nav-root { height: 64px; }
    .nav { display: none; }
  }
</style>
