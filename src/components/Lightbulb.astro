---
// Tuggable light bulb (vanilla port of jh3y/pen/VwjgdLj).
// Pulling the cord toggles the theme via --on CSS var on :root.
---

<div class="bulb-scene" data-bulb-scene aria-hidden="false">
  <svg
    class="toggle-scene"
    xmlns="http://www.w3.org/2000/svg"
    preserveAspectRatio="xMinYMin"
    viewBox="0 0 197.451 481.081"
  >
    <defs>
      <marker id="bulb-marker" orient="auto" overflow="visible" refx="0" refy="0">
        <path class="toggle-scene__cord-end" fill-rule="evenodd" stroke-width=".2666" d="M.98 0a1 1 0 11-2 0 1 1 0 012 0z"></path>
      </marker>
      <clipPath id="bulb-cap-clip" clipPathUnits="userSpaceOnUse">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="4.677" d="M-774.546 827.629s12.917-13.473 29.203-13.412c16.53.062 29.203 13.412 29.203 13.412v53.6s-8.825 16-29.203 16c-21.674 0-29.203-16-29.203-16z"></path>
      </clipPath>
    </defs>
    <g class="toggle-scene__cords">
      <path class="toggle-scene__cord" marker-end="url(#bulb-marker)" fill="none" stroke-linecap="square" stroke-width="6" d="M123.228-28.56v150.493" transform="translate(-24.503 256.106)"></path>
      <path class="toggle-scene__cord" marker-end="url(#bulb-marker)" fill="none" stroke-linecap="square" stroke-width="6" d="M123.228-28.59s28 8.131 28 19.506-18.667 13.005-28 19.507c-9.333 6.502-28 8.131-28 19.506s28 19.507 28 19.507" transform="translate(-24.503 256.106)"></path>
      <path class="toggle-scene__cord" marker-end="url(#bulb-marker)" fill="none" stroke-linecap="square" stroke-width="6" d="M123.228-28.575s-20 16.871-20 28.468c0 11.597 13.333 18.978 20 28.468 6.667 9.489 20 16.87 20 28.467 0 11.597-20 28.468-20 28.468" transform="translate(-24.503 256.106)"></path>
      <path class="toggle-scene__cord" marker-end="url(#bulb-marker)" fill="none" stroke-linecap="square" stroke-width="6" d="M123.228-28.569s16 20.623 16 32.782c0 12.16-10.667 21.855-16 32.782-5.333 10.928-16 20.623-16 32.782 0 12.16 16 32.782 16 32.782" transform="translate(-24.503 256.106)"></path>
      <path class="toggle-scene__cord" marker-end="url(#bulb-marker)" fill="none" stroke-linecap="square" stroke-width="6" d="M123.228-28.563s-10 24.647-10 37.623c0 12.977 6.667 25.082 10 37.623 3.333 12.541 10 24.647 10 37.623 0 12.977-10 37.623-10 37.623" transform="translate(-24.503 256.106)"></path>
      <g class="line toggle-scene__dummy-cord">
        <line marker-end="url(#bulb-marker)" x1="98.7255" x2="98.7255" y1="240.5405" y2="380.5405"></line>
      </g>
      <circle class="toggle-scene__hit-spot" cx="98.7255" cy="380.5405" r="60" fill="transparent"></circle>
    </g>
    <g class="toggle-scene__bulb bulb" transform="translate(844.069 -645.213)">
      <path class="bulb__cap" stroke-linecap="round" stroke-linejoin="round" stroke-width="4.677" d="M-774.546 827.629s12.917-13.473 29.203-13.412c16.53.062 29.203 13.412 29.203 13.412v53.6s-8.825 16-29.203 16c-21.674 0-29.203-16-29.203-16z"></path>
      <path class="bulb__cap-shine" d="M-778.379 802.873h25.512v118.409h-25.512z" clip-path="url(#bulb-cap-clip)" transform="matrix(.52452 0 0 .90177 -368.282 82.976)"></path>
      <path class="bulb__cap" stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M-774.546 827.629s12.917-13.473 29.203-13.412c16.53.062 29.203 13.412 29.203 13.412v0s-8.439 10.115-28.817 10.115c-21.673 0-29.59-10.115-29.59-10.115z"></path>
      <path class="bulb__cap-outline" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="4.677" d="M-774.546 827.629s12.917-13.473 29.203-13.412c16.53.062 29.203 13.412 29.203 13.412v53.6s-8.825 16-29.203 16c-21.674 0-29.203-16-29.203-16z"></path>
      <g class="bulb__filament" fill="none" stroke-linecap="round" stroke-width="5">
        <path d="M-752.914 823.875l-8.858-33.06"></path>
        <path d="M-737.772 823.875l8.858-33.06"></path>
      </g>
      <path class="bulb__bulb" stroke-linecap="round" stroke-width="5" d="M-783.192 803.855c5.251 8.815 5.295 21.32 13.272 27.774 12.299 8.045 36.46 8.115 49.127 0 7.976-6.454 8.022-18.96 13.273-27.774 3.992-6.7 14.408-19.811 14.408-19.811 8.276-11.539 12.769-24.594 12.769-38.699 0-35.898-29.102-65-65-65-35.899 0-65 29.102-65 65 0 13.667 4.217 26.348 12.405 38.2 0 0 10.754 13.61 14.746 20.31z"></path>
      <circle class="bulb__flash" cx="-745.343" cy="743.939" r="83.725" fill="none" stroke-dasharray="10,30" stroke-linecap="round" stroke-linejoin="round" stroke-width="10"></circle>
      <path class="bulb__shine" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="12" d="M-789.19 757.501a45.897 45.897 0 013.915-36.189 45.897 45.897 0 0129.031-21.957"></path>
    </g>
  </svg>
</div>

<style is:global>
  /* Bulb internals — reactive to body.theme-light. */
  :root {
    --cord-h: 0;
    --cord-s: 0%;
    --cord-l: 60%;
    --stroke-l: 60%;
    --shine-a: 0.75;
    --cap-l: 40%;
    --filament-h: 45;
    --filament-s: 0%;
    --filament-l: 25%;
    --bulb-fill-h: 180;
    --bulb-fill-s: 80%;
    --bulb-fill-l: 80%;
    --bulb-fill-a: 0.1;
  }
  body.theme-light {
    --cord-l: 35%;
    --stroke-l: 30%;
    --shine-a: 0.4;
    --cap-l: 55%;
    --filament-s: 50%;
    --filament-l: 80%;
    --bulb-fill-h: 85;
    --bulb-fill-a: 0.45;
  }

  /* Bulb scene: fixed top-right of nav, sized small. */
  .bulb-scene {
    position: relative;
    width: 26px;
    height: 64px;
    display: inline-block;
    pointer-events: auto;
    flex-shrink: 0;
    margin-right: 6px;
    margin-top: 14px;
  }
  .toggle-scene {
    overflow: visible !important;
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
  }
  .toggle-scene__cord {
    stroke: hsl(var(--cord-h) var(--cord-s) var(--cord-l));
    cursor: move;
  }
  .toggle-scene__cord:nth-of-type(1) { display: none; }
  .toggle-scene__cord:nth-of-type(2),
  .toggle-scene__cord:nth-of-type(3),
  .toggle-scene__cord:nth-of-type(4),
  .toggle-scene__cord:nth-of-type(5) { display: none; }
  .toggle-scene__cord-end {
    stroke: hsl(var(--cord-h) var(--cord-s) var(--cord-l));
    fill: hsl(var(--cord-h) var(--cord-s) var(--cord-l));
  }
  .toggle-scene__dummy-cord {
    stroke-width: 6;
    stroke: hsl(var(--cord-h) var(--cord-s) var(--cord-l));
  }
  .bulb__filament {
    stroke: hsl(var(--filament-h) var(--filament-s) var(--filament-l));
    transition: stroke .4s ease;
  }
  .bulb__shine {
    stroke: hsla(0, 0%, 100%, var(--shine-a));
    transition: stroke .4s ease;
  }
  .bulb__flash {
    stroke: #f5e0a3;
    display: none;
  }
  .bulb__bulb {
    stroke: hsl(0 0% var(--stroke-l));
    fill: hsla(var(--bulb-fill-h) var(--bulb-fill-s) var(--bulb-fill-l) / var(--bulb-fill-a));
    transition: stroke .4s ease, fill .4s ease;
  }
  .bulb__cap { fill: hsl(0 0% var(--cap-l)); transition: fill .4s ease; }
  .bulb__cap-shine { fill: hsla(0, 0%, 100%, var(--shine-a)); transition: fill .4s ease; }
  .bulb__cap-outline { stroke: hsl(0 0% var(--stroke-l)); transition: stroke .4s ease; }

  @media (max-width: 800px) {
    .bulb-scene { width: 22px; height: 54px; margin-top: 12px; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { Draggable } from 'gsap/Draggable';

  gsap.registerPlugin(Draggable);

  const scene = document.querySelector<HTMLElement>('.bulb-scene');
  if (scene) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const CORDS = scene.querySelectorAll<SVGPathElement>('.toggle-scene__cord');
    const HIT = scene.querySelector<SVGCircleElement>('.toggle-scene__hit-spot')!;
    const DUMMY = scene.querySelector<SVGGElement>('.toggle-scene__dummy-cord')!;
    const DUMMY_CORD = scene.querySelector<SVGLineElement>('.toggle-scene__dummy-cord line')!;

    const PROXY = document.createElement('div');
    const ENDX = +DUMMY_CORD.getAttribute('x2')!;
    const ENDY = +DUMMY_CORD.getAttribute('y2')!;
    const reset = () => gsap.set(PROXY, { x: ENDX, y: ENDY });
    reset();

    let on = false;
    const applyTheme = () => {
      document.documentElement.style.setProperty('--on', on ? '1' : '0');
      document.body.classList.toggle('theme-light', on);
    };

    const swing = (cord: SVGPathElement) => {
      const startY2 = ENDY - 80;
      gsap.fromTo(
        DUMMY_CORD,
        { attr: { x2: ENDX, y2: startY2 } },
        {
          attr: { x2: ENDX, y2: ENDY },
          duration: 0.18,
          ease: 'power2.out',
          onStart: () => {
            on = !on;
            applyTheme();
          },
          onComplete: () => reset()
        }
      );
    };

    let startX = 0, startY = 0;
    Draggable.create(PROXY, {
      trigger: HIT,
      type: 'x,y',
      onPress: (e: PointerEvent) => {
        startX = e.x;
        startY = e.y;
      },
      onDrag: function () {
        gsap.set(DUMMY_CORD, { attr: { x2: this.x, y2: this.y } });
      },
      onRelease: function (e: PointerEvent) {
        if (reduce) {
          on = !on;
          applyTheme();
          reset();
          return;
        }
        const dx = Math.abs(e.x - startX);
        const dy = Math.abs(e.y - startY);
        const travelled = Math.sqrt(dx * dx + dy * dy);
        gsap.to(DUMMY_CORD, {
          attr: { x2: ENDX, y2: ENDY },
          duration: 0.15,
          onComplete: () => {
            if (travelled > 50) swing(CORDS[0]);
            else reset();
          }
        });
      }
    });
  }
</script>